# 顯示寬度：自己解 UTF-8，查 East Asian Width。
#
# 給 md.awk（表格對齊、cell 折行）與 list.awk（標題截斷）共用。
# 用法是 awk 的多個 -f：awk -f width.awk -f md.awk
# 兩邊各自的 BEGIN 都會跑，順序照 -f 的順序，所以 ORD 表在這裡建好就行。
#
# ⚠️ 呼叫端一律要 LC_ALL=C。length() 回的是 byte 數還是字元數取決於實作與
# locale —— macOS BWK awk 20200816 在 UTF-8 locale 下 length("專案") == 6（byte），
# gawk 則是 2（字元）。統一成 byte 模式，寬度計算才有單一定義。
#
# ⚠️ 全部十進位。BWK awk 不認 0x80 這種十六進位常值，會解析成 0 接一個叫 x80
# 的空變數，比較永遠成立，UTF-8 解碼靜默歪掉。

BEGIN { for (_i = 0; _i < 256; _i++) ORD[sprintf("%c", _i)] = _i }

# decode 把 s 第 i 個 byte 起的一個 UTF-8 字元解出來，結果放在全域 CP / CLEN。
# 用全域而不是回傳值，因為 awk 的函式只能回一個值，而這裡兩個都要。
function decode(s, i,   b, j) {
    b = ORD[substr(s, i, 1)]
    if      (b < 128) { CP = b;       CLEN = 1 }
    else if (b < 224) { CP = b - 192; CLEN = 2 }
    else if (b < 240) { CP = b - 224; CLEN = 3 }
    else              { CP = b - 240; CLEN = 4 }
    for (j = 1; j < CLEN; j++) CP = CP * 64 + (ORD[substr(s, i + j, 1)] - 128)
}
function dw(s,   i, n, wid) {
    n = length(s); i = 1; wid = 0
    while (i <= n) {
        decode(s, i)
        i += CLEN
        wid += iswide(CP) ? 2 : 1
    }
    return wid
}
# East Asian Width = W 或 F 的區間。全部十進位（見檔頭第 2 點）。
function iswide(c) {
    # 4352 = 0x1100（Hangul Jamo 的起點）。比它小的一律是窄的 ——
    # ASCII、拉丁、希臘、斯拉夫、希伯來、阿拉伯、天城文全部在這下面。
    #
    # ⚠️ 這一行以前寫成 `if (c < 4352) { return 零星 emoji 的清單 }`，
    # 而那份清單裡每一個常數都 ≥ 8986（0x231A）—— 條件永遠不成立，整段是死碼，
    # 所以 ✅ 之類的字一直被算成寬度 1。找到的方式是讓 glyph 自己決定欄寬，
    # 看框線畫幾格：⬜ 畫 2 格、✅ 只畫 1 格，就露出來了。
    if (c < 4352) return 0

    # 0x2600-0x27BF 這一帶不能整段當寬 —— ☐ ☑ ✓ ▸ ● 都在裡面而且是窄的
    # （我們自己就用 ● 畫 bullet、▸ 畫小標題）。只有下面這些零星的
    # emoji-presentation 字元是 EAW=W，得一個一個列。
    if ((c >=  8986 && c <=  8987) ||      # ⌚⌛
        (c >=  9193 && c <=  9196) ||      # ⏩-⏬
         c ==  9200 || c ==  9203 ||       # ⏰ ⏳
        (c >=  9725 && c <=  9726) ||      # ◽◾
        (c >=  9748 && c <=  9749) ||      # ☔☕
        (c >=  9800 && c <=  9811) ||      # ♈-♓ 星座
         c ==  9855 || c ==  9875 || c ==  9889 ||
        (c >=  9898 && c <=  9899) || (c >=  9917 && c <=  9918) ||
        (c >=  9924 && c <=  9925) ||
         c ==  9934 || c ==  9940 || c ==  9962 ||
        (c >=  9970 && c <=  9971) ||
         c ==  9973 || c ==  9978 || c ==  9981 ||
         c ==  9989 ||                     # ✅ checklist 打勾用的就是它
        (c >=  9994 && c <=  9995) ||
         c == 10024 || c == 10060 || c == 10062 ||
        (c >= 10067 && c <= 10069) ||
         c == 10071 || (c >= 10133 && c <= 10135) ||
         c == 10160 || c == 10175) return 1

    # U+2B1B ⬛ / U+2B1C ⬜（checklist 未打勾的框）、U+2B50 ⭐、U+2B55 ⭕
    if ((c >= 11035 && c <= 11036) || c == 11088 || c == 11093) return 1

    # U+2329 〈 / U+232A 〉——「指向型」角括號，EAW=W。
    # 對照 PlantUML 的 Wcwidth.java 才發現漏的。
    # ⚠️ 不要跟 U+27E8 ⟨ / U+27E9 ⟩（數學角括號）搞混，那兩個是 EAW=A（窄），
    # c4.awk 的 ⟨邊界⟩ 用的正是後者。
    if (c == 9001 || c == 9002) return 1

    return (c >=  4352 && c <=  4447) ||   # Hangul Jamo
           (c >= 11904 && c <= 12245) ||   # CJK 部首補充、康熙部首
           (c >= 12272 && c <= 12350) ||   # 注音、假名（12351 = U+303F 是窄的）
           (c >= 12352 && c <= 13311) ||   # CJK 相容
           (c >= 13312 && c <= 19903) ||   # CJK 擴充 A
           (c >= 19968 && c <= 40959) ||   # CJK 統一漢字
           (c >= 40960 && c <= 42191) ||   # 彝文
           (c >= 44032 && c <= 55203) ||   # 韓文音節
           (c >= 63744 && c <= 64255) ||   # CJK 相容漢字
           (c >= 65040 && c <= 65135) ||   # 縱書標點
           (c >= 65280 && c <= 65376) ||   # 全形
           (c >= 65504 && c <= 65510) ||
           (c >= 127744 && c <= 129791) || # emoji
           (c >= 131072 && c <= 262141)    # CJK 擴充 B 以後
}
