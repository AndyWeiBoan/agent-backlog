# 把 stdin 跳脫成 JSON 字串的「內容」（不含外層引號）。
# 產生 JSON 比解析容易得多：規則是固定的，而且非 ASCII 直接原樣輸出就好
# （JSON 本來就是 UTF-8），所以中文不需要任何特殊處理。
BEGIN { ORS = "" }
{
    s = $0
    gsub(/\\/, "\\\\", s)          # 反斜線要先跳，否則會把後面加的跳脫又跳一次
    gsub(/"/,  "\\\"", s)
    gsub(/\t/, "\\t", s)
    gsub(/\r/, "\\r", s)
    # 其餘控制字元（0x00-0x1F）在我們的內容裡不會出現，先不處理
    print (NR > 1 ? "\\n" : "") s
}
